#X3D V3.2 utf8
PROFILE Interchange
COMPONENT Shaders:1

# -----------------------------------------------------------------------------
# Demonstrate integration of our Effects
# (see https://castle-engine.io/shaders )
# with geometry shaders.
#
# Here testing shapes with explicit Gouraud and Phong shading,
# to make sure both options work.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Gouraud version

Shape {
  appearance DEF ShaderAppearance Appearance {
    effects Effect {
      language "GLSL"
      parts EffectPart {
        type "GEOMETRY"
        url "data:text/plain,
          layout(triangles) in;
          layout(triangle_strip, max_vertices = 3) out;

          void geometryVertexSet(const int index);

          void main() {
            for(int i = 0; i < gl_in.length(); i++) {
              gl_Position = gl_in[i].gl_Position;
              /* do anything, just to see that geometry shader works */
              gl_Position.y += 2.0;
              geometryVertexSet(i);
              EmitVertex();
            }
            EndPrimitive();
          }"
      }
    }
    material Material {
    }
  }

  # This *would* look better with Phong shading, the SpotLight would be
  # clearly visible on the box.
  # But we force Gouraud shading, just to test that it works correctly
  # with geometry shaders.
  shading "GOURAUD"
  #shading "PHONG"

  geometry Box {
  }
}

# -----------------------------------------------------------------------------
# Phong shading version
# (reuses ShaderAppearance)

Transform {
  translation 0 -3 0
  children [
    Shape {
      appearance USE ShaderAppearance
      shading "PHONG"
      geometry Box {
      }
    }
  ]
}

# -----------------------------------------------------------------------------
# Spot light, to observe the difference between Gouraud and Phong shading
# on 2 boxes: cut off angle will be clearly visible only on box with Phong shading.

SpotLight {
  location 0 -1.5 10
  direction 0 0 -1
  cutOffAngle 0.17
  color 1 1 0
}

# -----------------------------------------------------------------------------
# Viewpoint

# Generated by castle-model-viewer.
# Use castle-model-viewer "Clipboard -> Print Current Camera..." to generate X3D code like below.
# Camera settings "encoded" in the X3D declaration below :
#   position 0 -1.5 12.73438
#   direction 0 0 -1
#   up 0 1 0
#   gravityUp 0 1 0
Viewpoint {
  position 0 -1.5 12.734375
  orientation 0 0 1 0
  autoCenterOfRotation TRUE
}
